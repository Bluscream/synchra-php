{
    "name": "bluscream/synchra",
    "description": "PHP SDK for the Synchra API (api.synchra.net) \u2014 full REST coverage plus the realtime WebSocket gateway.",
    "type": "library",
    "license": "MIT",
    "keywords": [
        "synchra",
        "streaming",
        "twitch",
        "youtube",
        "kick",
        "tiktok",
        "chat",
        "sdk",
        "api",
        "websocket"
    ],
    "homepage": "https://github.com/Bluscream/synchra-php",
    "support": {
        "issues": "https://github.com/Bluscream/synchra-php/issues",
        "source": "https://github.com/Bluscream/synchra-php"
    },
    "require": {
        "php": "^8.2",
        "ext-json": "*",
        "psr/http-client": "^1.0",
        "psr/http-factory": "^1.0",
        "psr/http-message": "^1.1 || ^2.0",
        "psr/log": "^1.1 || ^2.0 || ^3.0",
        "php-http/discovery": "^1.19"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.5 || ^12.0",
        "phpstan/phpstan": "^2.1",
        "friendsofphp/php-cs-fixer": "^3.64",
        "guzzlehttp/guzzle": "^7.8 || ^8.0",
        "nyholm/psr7": "^1.8",
        "phrity/websocket": "^3.8 || ^4.0"
    },
    "suggest": {
        "phrity/websocket": "Required by Synchra\\WebSocket\\PhrityTransport, the default realtime transport.",
        "guzzlehttp/guzzle": "A PSR-18 HTTP client; any PSR-18 implementation works."
    },
    "autoload": {
        "psr-4": {
            "Synchra\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Synchra\\Tests\\": "tests/",
            "Synchra\\Generator\\": "tools/Generator/"
        }
    },
    "scripts": {
        "generate": "@php tools/generate.php",
        "lint": "php-cs-fixer fix --dry-run --diff",
        "fix": "php-cs-fixer fix",
        "stan": "phpstan analyse",
        "test": "phpunit",
        "check": [
            "@lint",
            "@stan",
            "@test"
        ]
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "php-http/discovery": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
